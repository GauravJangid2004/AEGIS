# AEGIS Configuration
# Copy this file to .env and fill in your values

# ─── AI Model Configuration ───────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_REASONING_MODEL=llama3
DEFAULT_CODE_MODEL=deepseek-coder
DEFAULT_REPORT_MODEL=mistral
DEFAULT_VULN_MODEL=llama3

# Model temperature settings
REASONING_TEMPERATURE=0.3
CODE_TEMPERATURE=0.1
REPORT_TEMPERATURE=0.5

# ─── API Keys (Optional) ──────────────────────────────────────────
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
NVD_API_KEY=

# ─── Execution Settings ───────────────────────────────────────────
MAX_ATTACK_ITERATIONS=20
COMMAND_TIMEOUT=120
MAX_OUTPUT_LENGTH=5000
SAFE_MODE=true

# ─── Report Settings ──────────────────────────────────────────────
REPORT_OUTPUT_DIR=./reports
REPORT_COMPANY_NAME=AEGIS Security
REPORT_CLASSIFICATION=CONFIDENTIAL

# ─── Web UI Settings ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-this-to-a-random-secret-key
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Knowledge Base ───────────────────────────────────────────────
CHROMADB_PERSIST_DIR=./data/chromadb
CVE_DATABASE_PATH=./data/cve_database.json

# ─── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/aegis.log
